# Cursor agent auth: use CLI login, not an API key.
# Install: https://cursor.com/docs/cli/installation
# Then: agent login && agent status
# Optional override binary: TRENCHCOAT_CURSOR_BIN=/path/to/agent
# Optional (rarely needed): CURSOR_API_KEY=

# Bare host is fine — intake defaults to /v1/events. Prefer http://127.0.0.1 (not localhost).
TRENCHCOAT_ROUTER_URL=http://127.0.0.1:8787/v1/events
TRENCHCOAT_ROUTER_TOKEN=
TRENCHCOAT_ROUTER_HMAC_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=
TELEGRAM_ROUTER_BOT_TOKEN=
# Broadcast channel/chat id for the router bot (required for Telegram fanout)
TELEGRAM_ROUTER_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
COINGECKO_DEMO_KEY=
NEYNAR_API_KEY=
# Optional — only for `auth farcaster --create`
NEYNAR_WALLET_ID=
FARCASTER_APP_FID=
FARCASTER_APP_MNEMONIC=
HELIUS_API_KEY=
INFURA_API_KEY=
TAVILY_API_KEY=
DISCORD_WEBHOOK_URL=
TRENCHCOAT_LIVE_E2E=0
