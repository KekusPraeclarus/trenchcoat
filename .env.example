# Cursor agent auth: use CLI login, not an API key.
# Install: https://cursor.com/docs/cli/installation
# Then: agent login && agent status
# Optional override binary: TRENCHCOAT_CURSOR_BIN=/path/to/agent
# Git checkout for harness-improve (install-launchd writes this into ~/.trenchcoat/env):
# TRENCHCOAT_REPO_ROOT=/absolute/path/to/trench-bot
# Optional (rarely needed): CURSOR_API_KEY=

# Bare host is fine — intake defaults to /v1/events. Prefer http://127.0.0.1 (not localhost).
TRENCHCOAT_ROUTER_URL=http://127.0.0.1:8787/v1/events
TRENCHCOAT_ROUTER_TOKEN=
TRENCHCOAT_ROUTER_HMAC_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=
TELEGRAM_ROUTER_BOT_TOKEN=
# Broadcast channel/chat id for the router bot (required for Telegram fanout)
TELEGRAM_ROUTER_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
COINGECKO_DEMO_KEY=
NEYNAR_API_KEY=
# Optional — only for `auth farcaster --create`
NEYNAR_WALLET_ID=
FARCASTER_APP_FID=
FARCASTER_APP_MNEMONIC=
HELIUS_API_KEY=
INFURA_API_KEY=
# Optional OHLCV fallbacks when Gecko is rate-limited (chart-sweep / settle)
# SolanaTracker preferred for Solana; Birdeye for ethereum/base/bsc (and Solana last resort)
SOLANATRACKER_API_KEY=
BIRDEYE_API_KEY=
TAVILY_API_KEY=
DISCORD_WEBHOOK_URL=
# Private guild research bot (Gateway). Separate from broadcast webhook above.
DISCORD_RESEARCH_BOT_TOKEN=
# Sole Discord user whose broadcast reactions count as operator feedback (INV-B6)
DISCORD_OPERATOR_USER_ID=
TRENCHCOAT_LIVE_E2E=0
# Fomo auth is a headed Playwright burner profile (not an env secret):
#   pnpm dev:cli auth fomo
# Live probe gate: TRENCHCOAT_LIVE_FOMO=1
