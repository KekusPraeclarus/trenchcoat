{
  "name": "trenchcoat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "trenchcoat": "./dist/cli.js",
    "tc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:crash": "vitest run tests/crash",
    "test:redteam": "vitest run tests/redteam",
    "test:sandbox": "vitest run tests/sandbox",
    "test:e2e:live": "TRENCHCOAT_LIVE_E2E=1 vitest run tests/e2e",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:property && pnpm test:contract && pnpm test:integration && pnpm test:crash && pnpm test:redteam && pnpm test:sandbox",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/lint-static.ts",
    "probe:gecko": "tsx scripts/probe-geckoterminal.ts",
    "check": "pnpm typecheck && pnpm test",
    "prepare:agent": "tsx scripts/scaffold-agent.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "@noble/hashes": "^1.8.0",
    "better-sqlite3": "^11.10.0",
    "bs58": "^6.0.0",
    "fastify": "^5.10.0",
    "grammy": "^1.36.0",
    "playwright": "^1.54.1",
    "telegram": "^2.26.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.32",
    "fast-check": "^4.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
