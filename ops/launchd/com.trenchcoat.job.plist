<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only. Prefer: ops/install-launchd.sh
     Replace JOBNAME and INTERVAL_SECONDS if materializing by hand.
     Label convention: com.trenchcoat.job.JOBNAME -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trenchcoat.job.JOBNAME</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH="$HOME/Library/pnpm:/opt/homebrew/bin:/usr/local/bin:$PATH"; set -a; [ -f "$HOME/.trenchcoat/env" ] &amp;&amp; . "$HOME/.trenchcoat/env"; set +a; exec trenchcoat run JOBNAME</string>
  </array>
  <key>StartInterval</key>
  <integer>INTERVAL_SECONDS</integer>
  <key>StandardOutPath</key>
  <string>/tmp/trenchcoat.JOBNAME.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/trenchcoat.JOBNAME.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
